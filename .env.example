# 复制成 .env 再填。不填也能跑 —— 会自动用离线规则 Judge，报告里会标注。

# OpenAI 兼容端点。DeepSeek 国内直连、不用代理：https://platform.deepseek.com
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com

# 当裁判的模型
JUDGE_MODEL=deepseek-flash

# DeepSeek 的 thinking 默认开着，而开着时 temperature 会被静默忽略 ——
# 评测要的是可复现，所以默认关掉。留空则按 base_url 自动判断。
JUDGE_THINKING=disabled

# 单价覆盖（美元/百万 token）。不填则查内置表（见 judges/llm_judge.py，标注了取数日期），
# 查不到就记 0 并在报告里写「未配置单价」—— 别拿 0 当结论。
JUDGE_PRICE_IN=
JUDGE_PRICE_OUT=

# 设成 1 才走系统代理。macOS 上 Python 的 urllib 默认会读系统代理，
# 实测能把一个请求卡十几分钟 —— 所以默认是关的。
USE_SYSTEM_PROXY=
